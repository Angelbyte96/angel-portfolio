---
import CardProyects from '@components/CardProyects/CardProyects.astro'
import { getCollection } from 'astro:content'
const allProyects = await getCollection('allProyects')
---

<section class="mx-auto my-2 w-full text-white md:my-4" id="proyects">
  <h1 class="mb-2 text-3xl md:mb-4 md:text-4xl">Proyectos</h1>
  <p class="mb-4 text-sm md:text-lg">
    Te invito a <span class="text-yellow-300">explorar</span> mis proyectos más
    <span class="text-yellow-300">creativos</span> y <span
      class="text-yellow-300">desafiantes</span
    >. Cada uno representa mi <span class="text-yellow-300">compromiso</span> con
    el
    <span class="text-cyan-400">desarrollo web</span> y mi <span
      class="text-yellow-300">pasión</span
    > por
    <span class="text-yellow-300">transformar ideas</span> en
    <span class="text-cyan-400">soluciones digitales efectivas</span>. Estoy
    <span class="text-yellow-300">emocionado</span> de compartir contigo el
    <span class="text-cyan-400">resultado</span> de mi <span
      class="text-cyan-400">trabajo</span
    >. ¡
    <span class="text-yellow-300">Inspírate</span> y <span
      class="text-yellow-300">sumérgete</span
    > en mis proyectos de
    <span class="text-cyan-400">software</span>!
  </p>
  <main
    class="grid place-items-stretch gap-4 md:grid-cols-[repeat(auto-fit,minmax(300px,1fr))]"
  >
    {
      allProyects.map(async proyect => {
        const { data, id } = proyect
        const { title, img, tags, description, imgSize, url } = data

        return (
          <CardProyects
            title={title}
            img={img}
            tags={tags}
            slug={id}
            description={description}
            imgSize={imgSize}
            url={url}
          />
        )
      })
    }
  </main>
</section>
