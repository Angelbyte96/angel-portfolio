---
import CardProyects from '@components/CardProyects/CardProyects.astro'
import { getCollection } from 'astro:content'
const allProyects = await getCollection('allProyects')
---

<section
  class="mx-auto my-2 w-full text-[var(--color-text)] md:my-4"
  id="proyects"
>
  <h1 class="mb-2 text-3xl md:mb-4 md:text-4xl">Proyectos</h1>
  <p class="mb-4 text-sm md:text-base">
    Mi enfoque está en la creación de
    <span class="font-semibold text-[var(--color-accent)]"
      >soluciones con impacto real</span
    >. A continuación, presento mis
    <span class="font-medium text-[var(--color-highlight)]"
      >proyectos y desarrollos</span
    > más
    <span class="font-medium text-[var(--color-highlight)]">significativos</span
    >.
  </p>
  <main
    class="grid place-items-stretch gap-4 md:grid-cols-[repeat(auto-fit,minmax(300px,1fr))]"
  >
    {
      allProyects.map(async proyect => {
        const { data, id } = proyect
        const { title, img, tags, description, imgSize, url } = data

        return (
          <CardProyects
            title={title}
            img={img}
            tags={tags}
            slug={id}
            description={description}
            imgSize={imgSize}
            url={url}
          />
        )
      })
    }
  </main>
</section>
