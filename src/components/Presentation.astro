---
import { FileUser, Mail } from '@lucide/astro'
import GithubIcon from '@components/icons/GithubIcon.astro'
import LinkedinIcon from '@components/icons/LinkedinIcon.astro'

const style = {
  a: 'relative flex items-center justify-center rounded-full border border-white/10 bg-black/5 p-2.5 text-(--color-text) backdrop-blur-md transition-all duration-300 hover:-translate-y-1 hover:border-(--color-accent) hover:shadow-[0_0_20px_-5px_var(--color-accent)] md:p-3',
  svg: 'z-10 h-5 w-5 transition-all duration-300 group-hover:scale-110 group-hover:text-(--color-accent) md:h-6 md:w-6',
  svgFill:
    'z-10 h-5 w-5 fill-current transition-all duration-300 group-hover:scale-110 group-hover:text-(--color-accent) md:h-6 md:w-6',
  bgHover:
    'absolute inset-0 z-0 overflow-hidden rounded-full opacity-0 transition-opacity duration-300 group-hover:opacity-100 before:absolute before:inset-0 before:bg-linear-to-tr before:from-(--color-accent)/0 before:via-(--color-accent)/10 before:to-(--color-accent)/0',
}
---

<main class="mx-auto w-full" id="inicio">
  <section
    class="mx-auto grid w-full grid-cols-2 grid-rows-[auto_auto_auto_auto] gap-1 text-(--color-text)"
  >
    <div class="col-start-1 col-end-2 row-start-1 row-end-2 flex items-end p-1">
      <h1 class="text-2xl md:text-3xl">
        Hola, <span class="font-semibold text-(--color-accent)">soy Angel</span>
      </h1>
    </div>
    <div
      class="col-start-1 col-end-2 row-start-2 row-end-3 flex items-start p-1"
    >
      <h4 class="-mt-2 p-0 text-sm md:text-base">
        Desarrollador Web & Pasante de Ingeniería en Software y Redes
      </h4>
    </div>
    <div class="col-start-1 col-end-2 row-start-3 row-end-4 flex p-1">
      <p class="text-sm text-wrap md:text-base lg:text-lg">
        Especializado en construir
        <span class="font-semibold text-(--color-accent)"
          >soluciones digitales de alto rendimiento</span
        >
        y
        <span class="font-semibold text-(--color-accent)">escalabilidad</span>
        mediante
        <span class="font-medium text-(--color-highlight)"
          >flujos de trabajo optimizados</span
        >
        y
        <span class="font-medium text-(--color-highlight)"
          >tecnologías de vanguardia</span
        >.
      </p>
    </div>
    <div
      class="col-start-2 col-end-2 row-start-1 row-end-5 flex w-full items-center justify-center p-1"
    >
      <img
        class="aspect-square w-9/12 rounded-full object-cover sm:w-7/12 md:w-full lg:w-9/12 xl:w-7/12"
        src="/Angel-Profile.webp"
      />
    </div>
    <ul
      id="link-redes"
      class="col-start-1 col-end-2 row-start-4 row-end-4 flex p-1 text-base"
    >
      <li class="flex h-min list-none flex-row flex-wrap gap-4 md:gap-5">
        <a
          href="https://www.linkedin.com/in/Angelbyte"
          class=`group ${style.a}`
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Ver perfil de LinkedIn"
        >
          <div class={style.bgHover}></div>
          <LinkedinIcon class={style.svgFill} />
        </a>
        <a
          href="https://github.com/Angelbyte96"
          class=`group ${style.a}`
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Ver perfil de GitHub"
        >
          <div class={style.bgHover}></div>
          <GithubIcon class={style.svgFill} />
        </a>
        <button
          id="email"
          class=`group ${style.a} cursor-pointer`
          aria-label="Copiar correo electrónico"
        >
          <div class={style.bgHover}></div>
          <Mail id="email-icon" class={style.svg} />
          <div
            id="email-tooltip"
            class="pointer-events-none absolute -top-10 left-1/2 -translate-x-1/2 scale-90 rounded bg-(--color-accent) px-2 py-1 text-[10px] font-bold whitespace-nowrap text-white opacity-0 shadow-lg transition-all duration-300"
          >
            ¡Copiado!
            <div
              class="absolute -bottom-1 left-1/2 -translate-x-1/2 border-4 border-transparent border-t-(--color-accent)"
            >
            </div>
          </div>
        </button>
        <a
          href="https://res.cloudinary.com/ddinz4ewu/image/upload/v1783275005/Recursos/Portfolio/CV_Angel_krkll9.pdf"
          class=`group ${style.a}`
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Ver curriculum vitae"
        >
          <div class={style.bgHover}></div>
          <FileUser class={style.svg} />
        </a>
      </li>
      <script>
        const email = document.querySelector('#email')
        const emailTooltip = document.querySelector('#email-tooltip')
        email?.addEventListener('click', e => {
          e.preventDefault()
          const textToCopy = 'roberto.angel96@live.com'
          navigator.clipboard
            .writeText(textToCopy)
            .then(() => {
              emailTooltip?.classList.remove('opacity-0', 'scale-90')
              emailTooltip?.classList.add('opacity-100', 'scale-100')
              setTimeout(() => {
                emailTooltip?.classList.remove('opacity-100', 'scale-100')
                emailTooltip?.classList.add('opacity-0', 'scale-90')
              }, 2000)
            })
            .catch(error => console.error('Error al copiar el email', error))
        })
      </script>
    </ul>
  </section>
</main>
