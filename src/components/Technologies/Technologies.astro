---
import TechArticle from '@/components/Technologies/components/TechArticle.astro'
import TechItem from '@/components/Technologies/components/TechItem.astro'
import { technologiesList } from '@/components/Technologies/mocks/technologiesList'

const { frontEnd, backEnd, learning, tools } = technologiesList
---

<section
  class="mx-auto my-2 flex w-full flex-col items-center justify-center gap-3 text-white md:my-4"
>
  <h1 class="mb-2 self-start text-3xl md:mb-4 md:text-4xl" id="technologies">
    Tecnologías
  </h1>
  <p class="mb-4 self-start text-sm md:text-base">
    Mi enfoque en el <span class="text-yellow-300">desarrollo web</span> prioriza
    la creación de <span class="text-[#2cc9ff]">interfaces rápidas y escalables</span>.
    Me especializo en el <span class="text-[#2cc9ff]">ecosistema moderno de frontend</span>,
    apoyándome en un flujo de trabajo optimizado para entregar
    <span class="text-yellow-300">código limpio y arquitecturas sólidas</span>.
    <span class="text-yellow-300">Mi stack principal incluye:</span>
  </p>
  <div
    class="grid gap-1 md:w-full md:grid-cols-2"
    style={{
      boxShadow: '0 0 100px -45px #cb00cb',
    }}
  >
    <TechArticle title="FrontEnd">
      {frontEnd.map(item => <TechItem icon={item.icon} name={item.name} />)}
    </TechArticle>
    <TechArticle title="BackEnd">
      {backEnd.map(item => <TechItem icon={item.icon} name={item.name} />)}
    </TechArticle>
    <TechArticle title="Aprendiendo">
      {learning.map(item => <TechItem icon={item.icon} name={item.name} />)}
    </TechArticle>
    <TechArticle title="Herramientas">
      {tools.map(item => <TechItem icon={item.icon} name={item.name} />)}
    </TechArticle>
  </div>
</section>
