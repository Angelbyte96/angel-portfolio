---
const { title, img, tags, slug, description, imgSize, url } = Astro.props
import { isTagKey, stylesTags } from '@components/CardProyects/mocks/stylesTags'
import { ArrowUpRight } from '@lucide/astro'
---

<article
  class="flex w-fit flex-col items-center gap-2 rounded-2xl border border-(--color-border) bg-(--color-bg-card) px-2 py-4 shadow-(--card-shadow) backdrop-blur-lg transform-gpu"
>
  <a
    href={`/proyect/${slug}/`}
    class="mb-2 transition hover:scale-[1.02] xl:mb-0"
  >
    <img
      transition:name={`img-${slug}`}
      class=`rounded-3xl aspect-[${imgSize}]`
      src={img}
      alt={title}
    />
  </a>
  <div class="flex w-full justify-center">
    <a
      href={url}
      target="_blank"
      rel="noopener noreferrer"
      class="group flex w-fit items-center justify-center decoration-neutral-500 decoration-dotted underline-offset-[5px] hover:underline"
    >
      <h2
        transition:name={`h1-${title}`}
        class="text-xl font-semibold text-(--color-accent) uppercase md:text-2xl"
      >
        {title}
      </h2>
      <ArrowUpRight
        class="w-5 text-[#97dbff] opacity-50 duration-150 group-hover:translate-x-[1.5px] group-hover:-translate-y-1 group-hover:scale-110 group-hover:text-[#297c97] group-hover:opacity-100"
      />
    </a>
  </div>
  <p class="text-(--color-text-muted) text-sm text-wrap md:text-base">
    {description}
  </p>
  <ul class="mt-auto flex w-fit flex-wrap gap-2 self-start text-start">
    {
      tags.map((tag: string) => {
        const key = tag.toLowerCase()
        const style = isTagKey(key) ? stylesTags[key] : stylesTags.li
        return <li class={style}>{tag}</li>
      })
    }
  </ul>
</article>
