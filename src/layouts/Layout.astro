---
import Footer from '@/components/Footer.astro'
import Nav from '@/components/Nav.astro'
import '@/styles/global.css'
import { ClientRouter } from 'astro:transitions'

interface Props {
	title: string
}

const { title } = Astro.props
---

<!doctype html>
<html
	lang='es'
	class='scroll-pt-16 scrollbar-thumb-[var(--scrollbar-thumb)] scroll-smooth active:scrollbar-thumb-[var(--scrollbar-thumb-active)] md:scroll-pt-20'>
	<head>
		<meta charset='UTF-8' />
		<meta name='viewport' content='width=device-width' />
		<link rel='icon' type='image/svg+xml' href='/avatar.webp' />
		<meta name='generator' content={Astro.generator} />
		<link rel='canonical' href='https://angelbyte.dev/' />
		<title>{title}</title>
		<ClientRouter />
		<script is:inline>
			const storedTheme = localStorage.getItem('theme')
			const defaultTheme = 'dark'
			const initialTheme = storedTheme || defaultTheme

			document.documentElement.classList.toggle('dark', initialTheme === 'dark')
			localStorage.setItem('theme', initialTheme)
		</script>
	</head>
	<body
		class='font-sans grid min-h-svh grid-rows-[auto_1fr_auto] bg-scroll md:bg-fixed'>
		<Nav />
		<main class='mx-auto w-11/12 md:w-9/12'>
			<slot />
		</main>
		<Footer />
	</body>
</html>
