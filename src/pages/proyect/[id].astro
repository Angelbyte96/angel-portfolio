---
import Nav from '@/components/Nav.astro'
import '@/styles/global.css'
import '@/styles/scrollbarProyects.css'
import { getCollection, render } from 'astro:content'
import { ClientRouter } from 'astro:transitions'
import { Link } from '@lucide/astro'

export const getStaticPaths = async () => {
  const allProyects = await getCollection('allProyects')

  return allProyects.map(proyect => ({
    params: { id: proyect.id },
    props: { proyect },
  }))
}

const { proyect } = Astro.props
const { data } = proyect
const { title, img, imgSize, styleBody, url } = data

const { Content } = await render(proyect)
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{`${title}`}</title>
    <ClientRouter />
  </head>
  <body class={styleBody}>
    <Nav />
    <main
      class="font-monda mx-auto flex w-[90vw] flex-col items-center gap-6 md:w-6/12"
    >
      <h1
        transition:name={`h1-${title}`}
        class="self-center text-3xl whitespace-nowrap text-white uppercase md:text-5xl"
      >
        {`${title}`}
      </h1>
      <div class="relative inline-block">
        <a href={url} target="_blank" rel="noopener noreferrer" class="group">
          <img
            class={`rounded-3xl aspect-[${imgSize}] transition-all duration-300 group-hover:animate-pulse`}
            src={img}
            alt=""
          />
          <Link
            class="absolute top-2 right-2 h-5 w-5 cursor-pointer text-gray-500 group-hover:text-gray-700 md:h-10 md:w-10"
          />
        </a>
      </div>
      <div class="prose prose-invert mx-auto w-full max-w-none">
        <Content />
      </div>
    </main>
  </body>
</html>
