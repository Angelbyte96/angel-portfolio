---
import Layout from '@/layouts/Layout.astro'
import '@/styles/scrollbarProyects.css'
import { getCollection, render } from 'astro:content'
import { Link } from '@lucide/astro'
import GithubIcon from '@components/CardProyects/GithubIcon.astro'

export const getStaticPaths = async () => {
  const allProyects = await getCollection('allProyects')

  return allProyects.map(proyect => ({
    params: { id: proyect.id },
    props: { proyect },
  }))
}

const { proyect } = Astro.props
const { data } = proyect
const { title, img, imgSize, styleBody, url, github } = data
const padNotesLightThemeHook =
  proyect.id === '1_proyect' ? 'project-theme-padnotes' : ''

const { Content } = await render(proyect)
---

<Layout
  title={title}
  bodyClass={`${styleBody} ${padNotesLightThemeHook}`.trim()}
  mainClass="font-sans mx-auto flex w-[90vw] flex-col items-center gap-6 md:w-6/12"
  hideFooter={true}
>
  <h1
    transition:name={`h1-${title}`}
    class="self-center text-3xl whitespace-nowrap text-(--color-text) uppercase md:text-5xl"
  >
    {`${title}`}
  </h1>
  <div class="relative inline-block">
    <a href={url} target="_blank" rel="noopener noreferrer" class="group">
      <img
        class={`rounded-3xl aspect-[${imgSize}] transition-all duration-300 group-hover:animate-pulse`}
        src={img}
        alt=""
      />
      <Link
        class="absolute top-2 right-2 h-5 w-5 cursor-pointer text-gray-500 group-hover:text-gray-700 md:h-10 md:w-10"
      />
    </a>
    {github && (
      <a
        href={github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub repository"
        class="absolute top-2 left-2 rounded-lg p-1.5 text-gray-500 transition hover:scale-110 hover:text-gray-700"
      >
        <GithubIcon class="h-5 w-5 md:h-10 md:w-10" />
      </a>
    )}
  </div>
  <div class="prose dark:prose-invert mx-auto w-full max-w-none">
    <Content />
  </div>
</Layout>
