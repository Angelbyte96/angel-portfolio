{
  "compatibility_date": "2026-04-19",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "name": "angel-portfolio",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  "vars": {
    // Sitekey de Turnstile: es público, va a texto plano en el HTML del sitio.
    "TURNSTILE_SITE_KEY": "0x4AAAAAADvJ4HWcMKY2V2DV",
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "81c18c3e3ef8416fb1bf54ae47707292",
    },
  ],
}
